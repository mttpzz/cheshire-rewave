{
    auto_https disable_redirects    # active on Windows (port 80 used by other apps); remove on Ubuntu to enable HTTP→HTTPS auto-redirect
}

(secure_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

cat.rewave.local {
    tls internal
    import secure_headers

    # Cat (FastAPI) routes use trailing slash. Rewrite known endpoints
    # to avoid 307 redirects that break POST/upload from admin UI.
    @needs_slash {
        path /rabbithole /plugins /memory /settings /llm /embedder /auth /users
    }
    rewrite @needs_slash {path}/

    reverse_proxy cheshire-cat-core:80 {
        header_up X-Forwarded-Proto https
    }
}

litellm.rewave.local {
    tls internal
    import secure_headers
    reverse_proxy litellm:4000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_down Location "http://litellm.rewave.local" "https://litellm.rewave.local"
    }
}

# for Filebrowser service on ubuntu server
cat.files.local {
    tls internal
    import secure_headers
    reverse_proxy host.docker.internal:8080
}